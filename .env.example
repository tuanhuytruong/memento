# PostgreSQL (DEV must use the isolated memento_dev schema)
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/dwh
DB_SCHEMA=memento_dev

# Session and invite administration. Generate separate random secrets; never expose these to the browser.
SESSION_SECRET=replace-with-a-random-32-byte-or-longer-secret
INVITE_ADMIN_SECRET=replace-with-a-distinct-random-32-byte-or-longer-secret

# Server port; nginx proxies this to the DEV site at 127.0.0.1:3091.
API_PORT=3092

# Private Cloudflare R2 bucket. DEV objects must remain under memento_dev/.
R2_BUCKET=your-private-bucket
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret
R2_PREFIX=memento_dev/
